{
  "name": "@gptproto-ai/cli",
  "version": "1.1.0",
  "description": "Command-line client for documented GPTProto APIs.",
  "license": "MIT",
  "keywords": [
    "gptproto",
    "ai",
    "cli",
    "llm",
    "image-generation",
    "video-generation",
    "audio-generation"
  ],
  "homepage": "https://github.com/gptproto-ai/gptproto-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gptproto-ai/gptproto-cli.git"
  },
  "bugs": {
    "url": "https://github.com/gptproto-ai/gptproto-cli/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/client.js",
    "./client": "./dist/client.js",
    "./config": "./dist/config.js",
    "./pricing": "./dist/pricing.js"
  },
  "bin": {
    "gptproto": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "CONTRACT.md",
    "SUPPORTED_APIS.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node test/pricing.mjs && node test/smoke.mjs && node test/route-contract.mjs && node test/version.mjs",
    "test:routes": "npm run build && node test/route-contract.mjs",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
